#!/usr/bin/env zsh

# File: ~/.zshrc.local
# Sourced by: ~/.zshrc (at the end, so it can override anything)

# Keep machine-specific, interactive-only settings here: anything that isn't
# the same on every machine and only matters at the prompt. For example, not
# every machine has Java, conda or HuggingFace installed.
#
# Where other things go:
#   PATH and environment variables  → ~/.zshenv.local (scripts and cron see them too)
#   aliases shared with bash         → ~/.aliases.local
#   functions shared with bash       → ~/.functions.local
#   API keys and tokens              → ~/.zsh_secrets (chmod 600)
#
# Homebrew and nvm are already set up by the dotfiles (.zshenv), so they
# don't need to be added here.

# Examples:

# A completion that only exists on this machine
# command -v kubectl >/dev/null && source <(kubectl completion zsh)

# A key binding you only want here
# bindkey '^ ' autosuggest-accept
